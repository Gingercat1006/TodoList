<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.todo.features.category.mapper.CategoryMapper">

<select id = "findAllCategory" resultType = "com.example.todo.features.category.dto.CategoryResponse">
select category_id as "categoryId", name from category order by "categoryId"
</select>

<insert id= "insertCategory">
insert into category(name) values(#{name})
</insert>

</mapper>